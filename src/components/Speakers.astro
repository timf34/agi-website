---
import { speakers } from '../content';
---

<ul class="speakers">
  {
    speakers.map((s, i) => (
      <li class="speaker reveal" style={`--reveal-delay:${0.05 + (i % 6) * 0.05}s`}>
        <span class="portrait">
          <img src={s.photo} alt={s.name} width="400" height="480" loading="lazy" />
        </span>
        <span class="name">{s.name}</span>
        <span class="title">{s.title}</span>
      </li>
    ))
  }
</ul>

<style>
  .speakers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 32px 16px;
  }

  .speaker {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .portrait {
    display: block;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background: var(--pale);
    margin-bottom: 0.55rem;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(1);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 420;
    line-height: 1.25;
    color: var(--ink);
  }

  .title {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--slate);
  }

  @media (max-width: 1100px) {
    .speakers {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 560px) {
    .speakers {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px 12px;
    }

    .name {
      font-size: 0.85rem;
    }

    .title {
      font-size: 0.66rem;
    }
  }
</style>
