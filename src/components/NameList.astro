---
// Text-only list of people (name + title), used where portraits would be too much.
interface Props {
  people: { name: string; title: string; url?: string }[];
}
const { people } = Astro.props;
---

<ul class="names">
  {
    people.map((p, i) => (
      <li class="reveal" style={`--reveal-delay:${0.05 + i * 0.05}s`}>
        {p.url ? (
          <a class="name" href={p.url} target="_blank" rel="noopener noreferrer">
            {p.name}
          </a>
        ) : (
          <span class="name">{p.name}</span>
        )}
        <span class="title">{p.title}</span>
      </li>
    ))
  }
</ul>

<style>
  .names {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(24px, 4vw, 56px);
    border-top: 1px solid var(--hairline);
  }

  .names li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-block: 16px;
    border-bottom: 1px solid var(--hairline);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }

  a.name:hover {
    color: var(--blue);
  }

  .title {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--slate);
  }

  @media (max-width: 760px) {
    .names {
      grid-template-columns: 1fr;
    }
  }
</style>
