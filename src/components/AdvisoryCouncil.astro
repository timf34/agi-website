---
import { advisors } from '../content';

// Defaults to the advisory council; the team section passes its own list.
interface Props {
  people?: { name: string; title: string; photo: string; url?: string }[];
}
const { people = advisors } = Astro.props;
---

<ul class="council">
  {
    people.map((a, i) => (
      <li class="reveal" style={`--reveal-delay:${0.08 + i * 0.08}s`}>
        {a.url ? (
          <a class="advisor" href={a.url} target="_blank" rel="noopener noreferrer">
            <span class="portrait">
              <img src={a.photo} alt={a.name} width="400" height="480" loading="lazy" />
            </span>
            <span class="name">{a.name}</span>
            <span class="title">{a.title}</span>
          </a>
        ) : (
          <div class="advisor">
            <span class="portrait">
              <img src={a.photo} alt={a.name} width="400" height="480" loading="lazy" />
            </span>
            <span class="name">{a.name}</span>
            <span class="title">{a.title}</span>
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .council {
    list-style: none;
    display: grid;
    /* same column size as the speakers grid, so photos line up */
    grid-template-columns: repeat(6, 1fr);
    gap: 32px 16px;
  }

  .advisor {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }

  .portrait {
    display: block;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background: var(--pale);
    margin-bottom: 0.55rem;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 420;
    line-height: 1.25;
    color: var(--ink);
  }

  a.advisor:hover .name {
    color: var(--blue);
  }

  .title {
    font-size: 0.72rem;
    line-height: 1.4;
    text-wrap: balance;
    color: var(--slate);
  }

  @media (max-width: 860px) {
    .council {
      max-width: none;
      display: flex;
      gap: 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .council::-webkit-scrollbar {
      display: none;
    }

    .council > li {
      flex: 0 0 min(34vw, 150px);
      scroll-snap-align: start;
    }
  }

  @media (max-width: 420px) {
    .name {
      font-size: 0.98rem;
    }

    .title {
      font-size: 0.74rem;
    }
  }
</style>
